<svg width="300" height="300" viewBox="0 0 300 300" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <defs>
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a2e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#16213e;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="300" height="300" fill="url(#bgGradient)"/>

  <!-- Musical Notes -->
  <text x="150" y="120" font-size="40" text-anchor="middle" fill="#FF6B6B">🎵</text>
  <text x="80" y="180" font-size="35" text-anchor="middle" fill="#4ECDC4">🎶</text>
  <text x="220" y="180" font-size="35" text-anchor="middle" fill="#FFE66D">🎼</text>

  <!-- Falling Blocks -->
  <rect x="50" y="50" width="50" height="50" rx="10" fill="#FF6B6B" opacity="0.9"/>
  <rect x="200" y="70" width="50" height="50" rx="10" fill="#4ECDC4" opacity="0.9"/>
  <rect x="120" y="90" width="50" height="50" rx="10" fill="#FFE66D" opacity="0.9"/>
  <rect x="60" y="140" width="50" height="50" rx="10" fill="#95E1D3" opacity="0.9"/>
  <rect x="190" y="160" width="50" height="50" rx="10" fill="#DDA0DD" opacity="0.9"/>
  <rect x="125" y="200" width="50" height="50" rx="10" fill="#98D8C8" opacity="0.9"/>

  <!-- Title -->
  <text x="150" y="270" font-size="18" font-weight="bold" text-anchor="middle" fill="white" font-family="Arial Rounded MT Bold, Arial, sans-serif">
    Cascada Musical
  </text>
</svg>
